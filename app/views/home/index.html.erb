<div class="flex h-screen min-h-screen bg-white overflow-hidden pt-16">

  <% if logged_in? %>

    <!-- Sidebar -->
    <aside class="hidden sm:flex w-20 flex-col items-center space-y-6 border-r border-gray-300 py-4 relative">

      <!-- Toggle Button -->
      <%= render "ui/components/add_button",
                 id: "toggleColorsDesktop",
                 hidden: false,
                 extra_classes: "hidden sm:flex mt-32" %>

      <!-- Color Picker -->
      <%= render "ui/components/color_pickers", id: "colorCirclesDesktop" %>

    </aside>

    <!-- Main Content -->
    <main class="flex flex-1 flex-col space-y-10 px-10 py-8 overflow-auto">

      <!-- Header -->
      <header class="flex h-16 items-center">
        <%= form_with class: "w-full flex space-x-5 justify-between", url: home_path, method: :get, local: true do %>
          <%= text_field_tag :search, params[:search],
                             placeholder: "Hledat",
                             class: "w-3/4 rounded-lg bg-gray-100 px-4 py-2
                                     focus:outline-none focus:ring-2 focus:ring-gray-300" %>

          <%= select_tag :sort,
                         options_for_select(
                           [
                             ["Seřadit podle:", ""],
                             ["Názvu", "heading"],
                             ["Data vzniku", "created_at"],
                             ["Poslední úpravy", "updated_at"]
                           ],
                           params[:sort]
                         ),
                         class: "w-1/4 min-w-[10rem] rounded-lg bg-gray-100 px-4 py-2 focus:outline-none focus:ring-2 focus:ring-gray-300",
                         onchange: "this.form.submit();" %>

          <%= submit_tag "Search", class: "hidden" %>
        <% end %>
      </header>

      <!-- Page Title -->
      <section class="flex w-full justify-between items-end">

        <h1 class="text-5xl font-semibold tracking-tight">
          Poznámky
        </h1>

        <div class="flex flex-col items-center relative">

          <!-- Toggle Button -->
          <%= render "ui/components/add_button",
                     id: "toggleColorsMobile",
                     hidden: false,
                     extra_classes: "flex sm:hidden" %>

        </div>

      </section>

      <!-- Cards -->
      <section id="cards" class="grid gap-8 grid-cols-[repeat(auto-fit,minmax(19rem,1fr))]">

        <!-- New Note Form -->
        <template id="card-template">
          <%= render "notes/form" %>
        </template>

        <!-- Existing Notes -->
        <% (@notes || []).each do |note| %>
          <%= render "notes/note", note: note %>
        <% end %>

      </section>

    </main>

  <% else %>

    <p class="text-2xl w-full md:overline md:text-4xl flex justify-center items-center text-center">Přihlaste se, a
      využívejte služby naplno!</p>

  <% end %>

</div>