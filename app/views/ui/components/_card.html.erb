<div class="note-card min-h-50 relative w-80 rounded-2xl p-6">

<!--<div class="note-card relative w-80 rounded-2xl p-6 <%#= 'bg-[#{color}]' unless color.blank? %>">-->
  <!-- Star Button -->
  <button class="absolute top-4 right-4 flex h-10 w-10 items-center justify-center rounded-full bg-black">
    <svg class="h-5 w-5 text-yellow-400" fill="currentColor" viewBox="0 0 20 20">
      <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.286 3.974a1 1 0 00.95.69h4.178c.969 0 1.371 1.24.588 1.81l-3.38 2.455a1 1 0 00-.364 1.118l1.287 3.974c.3.922-.755 1.688-1.54 1.118l-3.38-2.455a1 1 0 00-1.176 0l-3.38 2.455c-.784.57-1.838-.196-1.539-1.118l1.287-3.974a1 1 0 00-.364-1.118L2.045 9.401c-.783-.57-.38-1.81.588-1.81h4.178a1 1 0 00.95-.69l1.286-3.974z"/>
    </svg>
  </button>

  <h2 class="text-lg font-semibold leading-snug text-black">
    New Note
  </h2>

  <p class="absolute bottom-6 text-sm text-black/70">
    <%= Date.today.strftime("%b %d, %Y") %>
  </p>

  <button class="absolute bottom-4 right-4 flex h-10 w-10 items-center justify-center rounded-full cursor-pointer bg-black">
    <svg class="h-5 w-5 text-white" fill="currentColor" viewBox="0 0 20 20">
      <path d="M17.414 2.586a2 2 0 010 2.828l-9.9 9.9-4.243 1.414 1.414-4.243 9.9-9.9a2 2 0 012.829 0z"/>
    </svg>
  </button>
</div>
