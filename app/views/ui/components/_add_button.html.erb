<%# Ensure extra_classes has a default %>
<% extra_classes ||= "" %>

<button
  id="<%= id %>"
  class="<%= [
               'flex h-10 w-10 items-center justify-center rounded-full bg-black text-white cursor-pointer',
               ('hidden' if hidden),
               extra_classes,
               'color-toggle'       # shared class for JS targeting (optional)
             ].compact.join(' ') %>"
>
  <svg
    class="size-6 transition-transform duration-300 plus-icon"
    xmlns="http://www.w3.org/2000/svg"
    fill="none"
    viewBox="0 0 24 24"
    stroke-width="1.5"
    stroke="currentColor"
  >
    <path stroke-linecap="round" stroke-linejoin="round"
          d="M12 4.5v15m7.5-7.5h-15" />
  </svg>
</button>
