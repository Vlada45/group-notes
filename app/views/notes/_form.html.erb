<div class="note-card min-h-50 relative w-80 rounded-2xl p-6">
  <%= form_with url: notes_path,
                method: :post,
                id: "new_note_form",
                data: { turbo: true } do |f| %>

    <!-- Star Button -->
    <button class="hidden absolute top-4 right-4 h-10 w-10 items-center justify-center rounded-full bg-black">
      <svg class="h-5 w-5 text-yellow-400" fill="currentColor" viewBox="0 0 20 20">
        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.286 3.974a1 1 0 00.95.69h4.178c.969 0 1.371 1.24.588 1.81l-3.38 2.455a1 1 0 00-.364 1.118l1.287 3.974c.3.922-.755 1.688-1.54 1.118l-3.38-2.455a1 1 0 00-1.176 0l-3.38 2.455c-.784.57-1.838-.196-1.539-1.118l1.287-3.974a1 1 0 00-.364-1.118L2.045 9.401c-.783-.57-.38-1.81.588-1.81h4.178a1 1 0 00.95-.69l1.286-3.974z"/>
      </svg>
    </button>

    <label class="space-y-4">
      <%= f.text_field :heading,
                       id: "card_head",
                       placeholder: "Nová poznámka",
                       class: "block w-full text-lg font-semibold text-black border-none outline-hidden",
                       required: true %>

      <%= f.text_field :description,
                       id: "card_des",
                       placeholder: "Zapište si poznámku k tomuto záznamu",
                       class: "block w-full text-sm font-semibold text-gray-700 border-none outline-hidden" %>
    </label>

    <p class="absolute bottom-6 text-sm text-black/70">
      Upraveno: <%= I18n.l(Time.current, format: "%-d. %-m. %Y %H:%M:%S") %>
    </p>

    <!-- Submit Button -->
    <button
      type="submit"
      id="submitBtn"
      class="hidden absolute bottom-4 right-4 h-10 w-10 items-center justify-center rounded-full cursor-pointer bg-black">
      <svg class="h-5 w-5 text-white" fill="currentColor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
        <path d="M20.285 2l-11.285 11.567-5.286-5.011-3.714 3.716 9 8.728 15-15.285z"/>
      </svg>
    </button>

    <%= f.hidden_field :color, id: "note_color" %>

  <% end %>
</div>